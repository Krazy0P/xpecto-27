MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.rosbwwd.mongodb.net/?authSource=admin
DB_NAME=xpecto
PORT=3000
HOST=0.0.0.0
# Use a long random string in production
JWT_SECRET=change-me-in-production
# How long a login lasts: plain seconds (86400) or with a unit: 30m, 24h, 7d
JWT_EXPIRES=24h
CORS_ORIGIN=http://localhost:5173
# Seeds only fest info, events, mess options and payment info when those collections are empty.
# Sponsors, workshops and team members are never seeded - manage them from the admin panel.
SEED_ON_START=true
UPLOAD_DIR=backend/uploads

# Admin credentials (provisioned on startup from backend)
ADMIN_EMAIL=admin@xpecto.org
ADMIN_PASSWORD=Admin@Xpecto2027
ADMIN_NAME=Super Admin
