# Leave EMPTY in development: the Vite dev server proxies /api and /uploads to the backend,
# so the browser sees one origin and the login cookie is always sent.
# Do NOT set this to http://127.0.0.1:3000 while opening the site on localhost:5173 -
# browsers treat those as different sites and drop the login cookie ("Session expired").
VITE_API_URL=
# Where the dev proxy forwards to (default http://localhost:3000)
VITE_PROXY_TARGET=http://localhost:3000
VITE_USE_MOCK=false
